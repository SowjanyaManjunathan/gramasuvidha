<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph"
    app:startDestination="@id/loginFragment">

    <fragment
        android:id="@+id/loginFragment"
        android:name="com.gramasuvidha.portal.ui.LoginFragment"
        android:label="Login">
        <action
            android:id="@+id/action_login_to_projectList"
            app:destination="@id/projectListFragment"
            app:popUpTo="@id/loginFragment"
            app:popUpToInclusive="true"
            app:enterAnim="@anim/fade_in"
            app:exitAnim="@anim/fade_out" />
        <action
            android:id="@+id/action_login_to_signUp"
            app:destination="@id/signUpFragment"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left" />
    </fragment>

    <fragment
        android:id="@+id/signUpFragment"
        android:name="com.gramasuvidha.portal.ui.SignUpFragment"
        android:label="Sign Up">
        <action
            android:id="@+id/action_signUp_to_projectList"
            app:destination="@id/projectListFragment"
            app:popUpTo="@id/loginFragment"
            app:popUpToInclusive="true"
            app:enterAnim="@anim/fade_in"
            app:exitAnim="@anim/fade_out" />
    </fragment>

    <fragment
        android:id="@+id/projectListFragment"
        android:name="com.gramasuvidha.portal.ui.ProjectListFragment"
        android:label="Projects">
        <action
            android:id="@+id/action_list_to_detail"
            app:destination="@id/projectDetailFragment"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right" />
        <action
            android:id="@+id/action_list_to_login"
            app:destination="@id/loginFragment"
            app:popUpTo="@id/projectListFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/projectDetailFragment"
        android:name="com.gramasuvidha.portal.ui.ProjectDetailFragment"
        android:label="Project Detail" />

</navigation>